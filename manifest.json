{
  "manifest_version": 3,
  "name": "Moodle Course Archiver",
  "description": "Save every file from a Moodle course - resources, folders, announcements, assignments and links - in a tidy folder structure.",
  "version": "0.5",

  "permissions": [
    "downloads",
    "storage",
    "unlimitedStorage",
    "scripting",
    "activeTab",
    "offscreen",
    "declarativeNetRequest"
  ],

  "host_permissions": [
    "https://moodle.pmf.uns.ac.rs/*",
    "https://*/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },

  "action": {
    "default_popup": "popup.html"
  }
}
